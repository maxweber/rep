{:paths ["src"]
 :tasks
 {serve {:doc "Starts the server: bb serve --port 8730 --dir work [--class-path a,b] [--shared-image] [--max-body-mb 32] [--door]. REP_PUBLIC_KEYS and REP_AUDIENCE say whose tokens it takes. Without a key it prints one token for a try on a laptop."
         :requires ([rep.server])
         :task (apply rep.server/-main *command-line-args*)}
  test {:doc "Runs the tests"
        :extra-paths ["test"]
        :requires ([clojure.test :as test])
        :task (let [namespaces '[rep.auth-test
                                 rep.server-test
                                 rep.files-test
                                 rep.door-test
                                 rep.image-test]]
                (apply require namespaces)
                (let [{:keys [fail error]} (apply test/run-tests namespaces)]
                  (when (pos? (+ fail error))
                    (System/exit 1))))}}}
