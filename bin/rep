#!/usr/bin/env bb
;; The rep client. Link this file into your PATH, it finds its sources
;; next to itself.
(require '[babashka.classpath :as classpath]
         '[babashka.fs :as fs])

(classpath/add-classpath
 (str (fs/path (fs/parent (fs/parent (fs/real-path *file*))) "src")))

(require '[rep.client])

(apply rep.client/-main *command-line-args*)
